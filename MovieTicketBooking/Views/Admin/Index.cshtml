@model AdminDashboardViewModel
@{ ViewData["Title"] = "Admin Dashboard"; }
<h1>Admin Dashboard</h1><div class="row g-3 mb-4">@foreach (var item in new[] { ("Movies", Model.Movies), ("Theatres", Model.Theatres), ("Customers", Model.Customers), ("Shows", Model.Shows), ("Bookings", Model.Bookings) }) { <div class="col-6 col-lg"><div class="card text-center"><div class="card-body"><div class="display-6">@item.Item2</div><div>@item.Item1</div></div></div></div> }</div><div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-primary" asp-controller="Movies" asp-action="Index">Manage Movies</a><a class="btn btn-outline-primary" asp-controller="Theatres" asp-action="Index">Manage Theatres</a><a class="btn btn-outline-primary" asp-controller="Customers" asp-action="Index">Manage Customers</a><a class="btn btn-outline-primary" asp-controller="Shows" asp-action="Index">Manage Shows</a><a class="btn btn-outline-primary" asp-controller="Bookings" asp-action="Index">Manage Bookings</a></div>
