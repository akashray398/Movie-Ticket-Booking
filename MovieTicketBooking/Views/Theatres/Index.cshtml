@model IEnumerable<TheatreDto>
@{ ViewData["Title"] = "Theatres"; }
<h1>Theatres</h1><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Name</th><th>Seats</th><th>ID</th></tr></thead><tbody>@foreach (var theatre in Model) { <tr><td>@theatre.TheatreName</td><td>@theatre.NumberofSeats</td><td>@theatre.TheatreID</td></tr> }</tbody></table></div>
