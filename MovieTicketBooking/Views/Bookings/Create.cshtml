@model BookingCreateViewModel
@{ ViewData["Title"] = "Book Tickets"; }
<h1>Book Tickets</h1><form method="post" class="col-lg-7">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Booking.ShowID" class="form-label">Show</label><select asp-for="Booking.ShowID" class="form-select"><option value="">Select a show</option>@foreach (var show in Model.Shows) { <option value="@show.ShowID">@show.MovieName at @show.TheatreName, @show.StartDate:g</option> }</select></div><div class="mb-3"><label asp-for="Booking.CustomerName" class="form-label"></label><input asp-for="Booking.CustomerName" class="form-control" /></div><div class="mb-3"><label asp-for="Booking.Email" class="form-label"></label><input asp-for="Booking.Email" class="form-control" type="email" /></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Booking.SeatType" class="form-label"></label><select asp-for="Booking.SeatType" class="form-select"><option>Platinum</option><option>Gold</option><option>Silver</option></select></div><div class="col-md-6 mb-3"><label asp-for="Booking.NumberOfSeats" class="form-label"></label><input asp-for="Booking.NumberOfSeats" class="form-control" min="1" max="4" /></div></div><div class="mb-3"><label asp-for="SeatNumbersText" class="form-label">Seat numbers</label><input asp-for="SeatNumbersText" class="form-control" placeholder="Example: 5, 6" /><small class="text-muted">The server validates availability and calculates the amount.</small></div><button class="btn btn-success" type="submit">Book tickets</button></form>
