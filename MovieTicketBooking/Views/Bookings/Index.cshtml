@model IEnumerable<BookingDto>
@{ ViewData["Title"] = "Bookings"; }
<h1>Bookings</h1><a class="btn btn-success mb-3" asp-action="Create">Book tickets</a><div class="table-responsive"><table class="table table-striped"><thead><tr><th>ID</th><th>Movie</th><th>Seats</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var booking in Model) { <tr><td>@booking.BookingID</td><td>@booking.MovieName</td><td>@string.Join(", ", booking.SeatNumbers)</td><td>@booking.Amount</td><td>@booking.BookingStatus</td><td><a class="btn btn-sm btn-primary" asp-action="Confirmation" asp-route-id="@booking.BookingID">Details</a>@if (booking.BookingStatus != "Cancelled") { <form class="d-inline" method="post" asp-action="Cancel" asp-route-id="@booking.BookingID">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" type="submit">Cancel</button></form> }</td></tr> }</tbody></table></div>
