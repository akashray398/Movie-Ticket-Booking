<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Movie Ticket Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand" asp-controller="Home" asp-action="Index">Movie Ticket Booking</a><div class="navbar-nav"><a class="nav-link" asp-controller="Movies" asp-action="Index">Movies</a><a class="nav-link" asp-controller="Theatres" asp-action="Index">Theatres</a><a class="nav-link" asp-controller="Shows" asp-action="Index">Shows</a><a class="nav-link" asp-controller="Bookings" asp-action="Index">Bookings</a><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a><a class="nav-link" asp-controller="Login" asp-action="Index">Login</a>@if (Context.Session.GetString("LoginID") != null) { <form method="post" asp-controller="Login" asp-action="Logout" class="d-inline">@Html.AntiForgeryToken()<button class="nav-link btn btn-link" type="submit">Logout</button></form> }</div></div></nav>
<main class="container py-4">@RenderBody()</main>
</body>
</html>
