@model LoginRequestDto
@{ ViewData["Title"] = "Login"; }
<h1>Login</h1><form method="post" class="col-md-6">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="LoginID" class="form-label"></label><input asp-for="LoginID" class="form-control" /></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" type="password" /></div><button class="btn btn-primary" type="submit">Sign in</button></form>
